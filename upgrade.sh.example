#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Production follows the fork deployment branch. The release/v3.8.50 branch is a
# frozen upstream snapshot and must not be used for fork upgrades.
BRANCH="${OMNIROUTE_DEPLOY_BRANCH:-to/main}"
if [ "$BRANCH" = "release/v3.8.50" ]; then
  echo "Ignoring stale OMNIROUTE_DEPLOY_BRANCH=release/v3.8.50; using to/main" >&2
  BRANCH="to/main"
fi
REPOSITORY="${OMNIROUTE_GITHUB_REPOSITORY:-TonisOrmisson/OmniRoute}"

git fetch origin "$BRANCH"
git checkout "$BRANCH"
git reset --hard "origin/$BRANCH"

EXPECTED_SHA="$(git rev-parse --short=7 HEAD)"
EXPECTED_VERSION="$(node -p "require('./package.json').version")"
PREBUILT_URL="https://github.com/$REPOSITORY/releases/download/prebuilt-$EXPECTED_VERSION-$EXPECTED_SHA/omniroute-prebuilt-$EXPECTED_VERSION-$EXPECTED_SHA.tar.gz"

# CI may still be building the exact commit that was just fetched. Wait here so
# one invocation completes the upgrade without installing dependencies on prod.
for attempt in $(seq 1 45); do
  if curl -fsIL "$PREBUILT_URL" >/dev/null; then
    break
  fi
  if [ "$attempt" = "45" ]; then
    echo "No prebuilt release asset for commit $EXPECTED_SHA after 45 minutes." >&2
    exit 1
  fi
  echo "Waiting for prebuilt $EXPECTED_SHA ($attempt/45)..."
  sleep 60
done

echo "Installing prebuilt OmniRoute bundle from GitHub Release: $PREBUILT_URL"
bash scripts/install-prebuilt.sh "$PREBUILT_URL"

# The standalone bundle contains its runtime dependencies. Keep the source checkout
# but remove build-time dependencies after PM2 has been restarted.
pm2_path="$(command -v pm2 || true)"
case "$pm2_path" in
  "$PWD/node_modules/"*)
    echo "Keeping node_modules because PM2 is installed locally: $pm2_path"
    ;;
  *)
    rm -rf node_modules .build
    echo "Removed build-time node_modules and .build; runtime is in dist/"
    ;;
esac

read_env_value() {
  local name="$1"
  if [ ! -f .env ]; then
    return 0
  fi
  sed -n "s/^[[:space:]]*${name}[[:space:]]*=[[:space:]]*//p" .env |
    head -n 1 |
    sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
}

HEALTH_PORT="${OMNIROUTE_DASHBOARD_PORT:-${DASHBOARD_PORT:-}}"
HEALTH_PORT="${HEALTH_PORT:-$(read_env_value OMNIROUTE_DASHBOARD_PORT)}"
HEALTH_PORT="${HEALTH_PORT:-$(read_env_value DASHBOARD_PORT)}"
HEALTH_PORT="${HEALTH_PORT:-${OMNIROUTE_PORT:-${PORT:-}}}"
HEALTH_PORT="${HEALTH_PORT:-$(read_env_value OMNIROUTE_PORT)}"
HEALTH_PORT="${HEALTH_PORT:-$(read_env_value PORT)}"
HEALTH_PORT="${HEALTH_PORT:-20128}"

echo "=== Health Check (gates the upgrade) ==="
ok=0
for attempt in $(seq 1 36); do
  body="$(curl -sf -m 5 "http://127.0.0.1:${HEALTH_PORT}/api/monitoring/health" 2>/dev/null || true)"
  if printf '%s' "$body" | grep -q '"status":"healthy"'; then
    ok=1
    echo "✅ /api/monitoring/health -> healthy (attempt $attempt)"
    break
  fi
  echo "… not healthy yet (attempt $attempt/36), retrying in 5s"
  sleep 5
done

if [ "$ok" != "1" ]; then
  echo "❌ Health check failed — recent PM2 logs:" >&2
  pm2 logs omniroute --lines 40 --nostream || true
  exit 1
fi

git status --short

RUNNING_VERSION="$(node -p "require('./dist/package.json').version" 2>/dev/null || true)"
if [ "$RUNNING_VERSION" != "$EXPECTED_VERSION" ]; then
  echo "❌ Version check failed: source=$EXPECTED_VERSION, running=$RUNNING_VERSION" >&2
  exit 1
fi
echo "✅ Version check passed: $RUNNING_VERSION"
