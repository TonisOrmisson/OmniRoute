#!/usr/bin/env bash
# Also support operators invoking this file with `sh upgrade.sh`.
[ -n "${BASH_VERSION:-}" ] || exec bash "$0" "$@"
set -euo pipefail

cd "$(dirname "$0")"

# Deploy published releases, never an unbuilt branch tip.
REPOSITORY="${OMNIROUTE_GITHUB_REPOSITORY:-TonisOrmisson/OmniRoute}"
if [[ ! "$REPOSITORY" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$ ]]; then
  echo "Invalid OMNIROUTE_GITHUB_REPOSITORY" >&2
  exit 1
fi
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Tracked local edits found; refusing to overwrite them." >&2
  exit 1
fi
exec 9>"$(git rev-parse --git-path omniroute-upgrade.lock)"
flock -n 9 || { echo "Another upgrade is running." >&2; exit 1; }

previous_ref="$(git symbolic-ref --quiet --short HEAD || git rev-parse HEAD)"
# Same filesystem as dist/, so retaining/restoring the old bundle is a rename.
mkdir -p .tmp
tmp_dir="$(mktemp -d "$PWD/.tmp/upgrade.XXXXXX")"
checkout_changed=0
install_started=0
cleanup() {
  status=$?
  trap - EXIT
  if [ "$status" -ne 0 ]; then
    if [ "$install_started" = 1 ]; then
      echo "Upgrade failed; restoring the previous bundle and checkout." >&2
      pm2 delete omniroute 9>&- 2>/dev/null || true
      rm -rf dist
      if [ -e "$tmp_dir/previous-dist" ]; then
        mv "$tmp_dir/previous-dist" dist || {
          echo "Restore failed; backup retained at $tmp_dir/previous-dist" >&2
          exit 1
        }
      fi
    fi
    if [ "$checkout_changed" = 1 ]; then
      git checkout "$previous_ref" || { echo "Restore checkout manually; files retained at $tmp_dir" >&2; exit 1; }
    fi
    if [ "$install_started" = 1 ] && [ -d dist ]; then
      pm2 start ecosystem.config.cjs --update-env 9>&- && pm2 save 9>&- || {
        echo "Previous bundle restored, but PM2 restart failed; inspect $tmp_dir" >&2
        exit 1
      }
    fi
  fi
  rm -rf "$tmp_dir"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

curl -fsSL --connect-timeout 15 --max-time 60 \
  "https://api.github.com/repos/$REPOSITORY/releases/latest" -o "$tmp_dir/release.json"
node - "$tmp_dir/release.json" "$REPOSITORY" > "$tmp_dir/selected" <<'NODE'
const fs = require("node:fs");
const release = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));
const repository = process.argv[3];
const match = /^prebuilt-(\d+\.\d+\.\d+)-([0-9a-f]{7,40})$/.exec(release.tag_name || "");
if (!match || release.draft !== false || release.prerelease !== false || !release.published_at) {
  throw new Error("Latest release is not a published stable prebuilt release");
}
const [, version, sha] = match;
const name = `omniroute-prebuilt-${version}-${sha}.tar.gz`;
const url = `https://github.com/${repository}/releases/download/${release.tag_name}/${name}`;
const asset = (release.assets || []).find(a => a.name === name && a.state === "uploaded");
if (!asset || asset.browser_download_url !== url) {
  throw new Error("Published release has no ready matching prebuilt asset; current installation unchanged");
}
console.log([release.tag_name, version, sha, url].join("\t"));
NODE
IFS=$'\t' read -r RELEASE_TAG EXPECTED_VERSION EXPECTED_SHA PREBUILT_URL < "$tmp_dir/selected"
echo "Selected published release: $RELEASE_TAG"

git fetch --no-tags origin "refs/tags/$RELEASE_TAG"
release_commit="$(git rev-parse 'FETCH_HEAD^{commit}')"
if [[ "$release_commit" != "$EXPECTED_SHA"* ]]; then
  echo "Release tag does not match the artifact SHA; current installation unchanged." >&2
  exit 1
fi
archive="$tmp_dir/prebuilt.tar.gz"
curl -fL --connect-timeout 15 --max-time 900 "$PREBUILT_URL" -o "$archive"
mkdir "$tmp_dir/metadata"
tar -xzf "$archive" -C "$tmp_dir/metadata" ./BUILD_SHA ./package.json ./server.js
node - "$tmp_dir/metadata" "$EXPECTED_VERSION" "$release_commit" <<'NODE'
const fs = require("node:fs");
const path = require("node:path");
const [dir, version, commit] = process.argv.slice(2);
const sha = fs.readFileSync(path.join(dir, "BUILD_SHA"), "utf8").trim();
const pkg = JSON.parse(fs.readFileSync(path.join(dir, "package.json"), "utf8"));
if (!/^[0-9a-f]{7,40}$/.test(sha) || !commit.startsWith(sha) || pkg.version !== version) {
  throw new Error("Bundle version/SHA does not match the published release; current installation unchanged");
}
NODE

# Pin the source checkout to the same release. Never reset a deployment branch.
git checkout --detach "$release_commit"
checkout_changed=1
if [ -e dist ]; then
  mv dist "$tmp_dir/previous-dist"
fi
install_started=1
# Do not let the PM2 daemon inherit the upgrade lock.
bash scripts/install-prebuilt.sh "$archive" 9>&-

read_env_value() {
  local name="$1"
  if [ ! -f .env ]; then
    return 0
  fi
  sed -n "s/^[[:space:]]*${name}[[:space:]]*=[[:space:]]*//p" .env |
    head -n 1 |
    sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
}
HEALTH_PORT="${OMNIROUTE_DASHBOARD_PORT:-${DASHBOARD_PORT:-}}"
HEALTH_PORT="${HEALTH_PORT:-$(read_env_value OMNIROUTE_DASHBOARD_PORT)}"
HEALTH_PORT="${HEALTH_PORT:-$(read_env_value DASHBOARD_PORT)}"
HEALTH_PORT="${HEALTH_PORT:-${OMNIROUTE_PORT:-${PORT:-}}}"
HEALTH_PORT="${HEALTH_PORT:-$(read_env_value OMNIROUTE_PORT)}"
HEALTH_PORT="${HEALTH_PORT:-$(read_env_value PORT)}"
HEALTH_PORT="${HEALTH_PORT:-20128}"

for attempt in $(seq 1 36); do
  if curl -fsS -m 5 "http://127.0.0.1:${HEALTH_PORT}/api/monitoring/health" |
    node -e 'let s=""; process.stdin.on("data", c => s += c); process.stdin.on("end", () => { try { process.exit(JSON.parse(s).status === "healthy" ? 0 : 1); } catch { process.exit(1); } });'; then
    echo "Upgrade complete: $RELEASE_TAG (version $EXPECTED_VERSION, build $EXPECTED_SHA)"
    exit 0
  fi
  echo "Not healthy yet (attempt $attempt/36), retrying in 5s"
  sleep 5
done
echo "Health check failed." >&2
exit 1
